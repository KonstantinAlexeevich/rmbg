{
  "name": "rmbg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome-расширение: удаление фона с изображений локально в браузере (ISNet, onnxruntime-web)",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "build:store": "tsc --noEmit && vite build --mode store",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts && node scripts/copy-ort-assets.mjs dist-web",
    "preview:web": "vite preview --config vite.config.web.ts",
    "models": "node scripts/fetch-models.mjs",
    "package": "npm run build && cd dist && zip -r ../rmbg.zip . -x '.*'",
    "package:store": "npm run build:store && cd dist && zip -r ../rmbg.zip . -x '.*'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "promo:capture": "node promo/capture.mjs",
    "promo:render": "node promo/render.mjs",
    "promo": "npm run promo:capture && npm run promo:render"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "lucide-react": "^1.28.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.280",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
