# URL web-студии для сборки расширения (SW + host_permissions + content_scripts).
# По умолчанию: http://localhost:5173/studio
# VITE_STUDIO_WEB_URL=http://localhost:5173/studio
#
# Origin для canonical / Open Graph на лендинге (web-сборка).
# Если не задан — берётся origin из VITE_STUDIO_WEB_URL.
# VITE_SITE_ORIGIN=https://your-studio.example.com
