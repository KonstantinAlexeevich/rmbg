{
  "manifest_version": 3,
  "name": "PNG Maker",
  "version": "0.1.0",
  "description": "Try PNG Maker - a simple background remover. Create a transparent PNG with a clear background and save multiple images easily.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open PNG Maker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["storage", "downloads", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:5173/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["studio-bridge.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http: https: data: blob: https://huggingface.co https://*.hf.co https://*.aws.cdn.hf.co"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
